<Window x:Class="YangTools.Revit.UI.AlignTextToLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对齐到线"
        Width="470" MinWidth="440" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="对齐到线" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="选择一个文本，并用两个点定义基准线" Foreground="{DynamicResource TitleText}" FontSize="11"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,16,18,12">
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,12,10">
                        <TextBlock Text="目标文本" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock x:Name="TxtTextStatus" Text="未选择文本" Foreground="{DynamicResource DangerBg}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="1" Content="选择文本" MinWidth="92" Height="32"
                            Style="{DynamicResource StandardButton}" Click="BtnSelectText_Click"/>

                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="基准线" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock x:Name="TxtLineStatus" Text="未绘制基准线" Foreground="{DynamicResource DangerBg}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="绘制基准线" MinWidth="92" Height="32"
                            Style="{DynamicResource StandardButton}" Click="BtnSelectLine_Click"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <CheckBox x:Name="ChkKeepUpright" Content="保持文字正向" Margin="0,0,0,12"/>
                    <TextBlock Text="基点对齐方式" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbAlignBase" SelectedValuePath="Tag">
                        <ComboBoxItem Content="保持原位置，仅调整角度" Tag="Retain"/>
                        <ComboBoxItem Content="文本基点移动到基准线起点" Tag="Start"/>
                        <ComboBoxItem Content="文本基点移动到基准线终点" Tag="End"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="82" Margin="0,0,10,0" Style="{DynamicResource StandardButton}" Click="BtnCancel_Click"/>
                <Button Content="确定" Width="90" Style="{DynamicResource PrimaryButton}" Click="BtnOk_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
