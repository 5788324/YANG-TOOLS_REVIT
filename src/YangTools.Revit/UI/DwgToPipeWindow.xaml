<controls:YangWindow x:Class="YangTools.Revit.UI.DwgToPipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YangTools.Revit.UI.Controls"
        Title="DWG 转管道" Subtitle="识别直线 / 多段线 / 三维多段线并自动连接"
        Width="740" Height="640" MinWidth="640" MinHeight="540"
        ShowMaximizeButton="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：DWG 信息与图层筛选 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="全选" Click="SelectAll_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="全不选" Click="SelectNone_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button Content="反选" Click="InvertSelection_Click" Padding="10,4"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DwgInfoText" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="LayerSearchBox" Width="180" Height="28" Padding="8,2"
                         ToolTip="输入关键字过滤图层名称" TextChanged="LayerSearchBox_TextChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- 图层多选表格 -->
        <DataGrid Grid.Row="1" x:Name="LayerGrid"
                  Style="{DynamicResource SharedDataGridStyle}"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="选用" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" Margin="0"
                                      Checked="LayerSelection_Changed" Unchecked="LayerSelection_Changed"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="DWG 图层名称" Binding="{Binding LayerName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="直线" Binding="{Binding LineCount}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="多段线" Binding="{Binding PolyLineCount}" Width="76" IsReadOnly="True"/>
                <DataGridTextColumn Header="维度" Binding="{Binding ThreeDTag}" Width="96" IsReadOnly="True"/>
                <DataGridTextColumn Header="总段数" Binding="{Binding TotalSegments}" Width="76" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 管道参数卡片 -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="管道系统" Style="{DynamicResource FieldLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SystemTypeCombo" DisplayMemberPath="Name"/>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="管道类型" Style="{DynamicResource FieldLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="4" x:Name="PipeTypeCombo" DisplayMemberPath="Name"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="管径 (mm)" Style="{DynamicResource FieldLabel}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DiameterCombo" IsEditable="True"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="参照标高" Style="{DynamicResource FieldLabel}"/>
                <ComboBox Grid.Row="2" Grid.Column="4" x:Name="LevelCombo" DisplayMemberPath="Name"/>
            </Grid>
        </Border>

        <!-- 高程与连接选项卡片 -->
        <Border Grid.Row="3" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="高程处理方式" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkIgnoreDwgZ" Content="忽略 DWG 自身 Z 值（按参照标高 + 偏移拍平）"
                              IsChecked="False" Margin="0,3,0,8"
                              Checked="IgnoreDwgZ_Changed" Unchecked="IgnoreDwgZ_Changed"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock x:Name="OffsetLabel" Text="Z 附加偏移 (mm)：" Style="{DynamicResource FieldLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="OffsetBox" Text="0" Width="92" Height="28" Padding="6,2"/>
                    </StackPanel>
                    <TextBlock x:Name="ElevationHintText" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                               Text="默认直接采用 DWG 图元的实际 Z 坐标（支持 3D 多段线坡度与立管）。"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="自动连接与过滤" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkConnectPoly" Content="自动连接多段线转角（弯头）" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkConnectEndpoints" Content="自动连接共端点（弯头 / 三通 / 四通）" IsChecked="True" Margin="0,2"/>
                    <CheckBox x:Name="ChkMergeCollinear" Content="自动合并共线连续短段" IsChecked="True" Margin="0,2,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="连接容差：" Style="{DynamicResource FieldLabel}" Margin="0,0,4,0"/>
                        <TextBox x:Name="ToleranceBox" Text="20" Width="52" Height="26" Padding="4,2" Margin="0,0,10,0"/>
                        <TextBlock Text="最短段：" Style="{DynamicResource FieldLabel}" Margin="0,0,4,0"/>
                        <TextBox x:Name="MinLengthBox" Text="50" Width="52" Height="26" Padding="4,2"/>
                        <TextBlock Text="mm" Style="{DynamicResource FieldLabel}" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态与操作按钮 -->
        <DockPanel Grid.Row="4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="生成管道" Style="{DynamicResource PrimaryButton}" Width="104" IsDefault="True" Click="Run_Click" Margin="0,0,8,0"/>
                <Button Content="取消" Style="{DynamicResource StandardButton}" Width="84" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="SelectionSummaryText" Style="{DynamicResource SecondaryLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</controls:YangWindow>
