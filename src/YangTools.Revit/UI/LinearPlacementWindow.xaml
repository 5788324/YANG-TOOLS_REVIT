<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.LinearPlacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="线性布置" Height="720" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource WindowBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource TitleBarGradient}">
                <Grid>
                    <TextBlock Text="线性布置 (Linear Placement)" Foreground="{DynamicResource TitleText}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="14"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0" Click="CloseButton_Click">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TitleText}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="选择路径 (Select Path):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="拾取路径 (Pick Path)" Click="PickPath_Click" Padding="10,3" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding TotalLengthDisplay}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PathInfoText}" TextWrapping="Wrap" Margin="0,0,0,9"
                               Foreground="{DynamicResource SecondaryText}" FontSize="11"/>

                    <TextBlock Text="选择族类型 (Family Type):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <ComboBox ItemsSource="{Binding AvailableSymbols}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSymbol}" Margin="0,0,0,15" IsEditable="True"/>

                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="高程设置" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                            <TextBlock Text="基准标高:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableLevels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLevel}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedLevelElevationDisplay}" Foreground="{DynamicResource AccentColor}" FontSize="11" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="起点高程 (mm):" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding StartElevationMm, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="终点高程 (mm):" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding EndElevationMm, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="实际世界高度 = 基准标高的项目坐标高程 + 输入高程；若标高使用共享高程显示，也不会重复加减共享坐标偏移。首尾实例精确对应起/终点高程，中间实例按路线位置线性插值。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="布置模式 (Placement Mode):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Content="按距离 (Distance)" IsChecked="{Binding IsByDistance}" Margin="0,0,15,0" Foreground="{DynamicResource PrimaryText}"/>
                        <RadioButton Content="按参数 (Parameter, 0~1)" IsChecked="{Binding IsByParameter}" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>

                    <TextBlock Text="细分模式 (Division Mode):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Content="固定间距 (Spacing)" IsChecked="{Binding IsBySpacing}" Margin="0,0,15,0" Foreground="{DynamicResource PrimaryText}"/>
                        <RadioButton Content="固定数量 (Count)" IsChecked="{Binding IsByCount}" Foreground="{DynamicResource PrimaryText}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="布置起点 (Start Position):" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StartValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="布置终点 (End Position):" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EndValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="{Binding SpacingOrCountLabel}" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding StepValue, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="方向选项 (Orientation Options):" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource PrimaryText}"/>
                    <CheckBox Content="对齐切线 (Align to Curve Tangent)" IsChecked="{Binding AlignToCurve}" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryText}"/>
                    <CheckBox Content="保持垂直 (Keep Z Vertical)" IsChecked="{Binding KeepVertical}" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryText}"/>
                    <CheckBox Content="反转路线首尾" IsChecked="{Binding ReversePath}" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryText}"/>
                    <CheckBox Content="末尾不足一个间距时，在终点补放一个实例" IsChecked="{Binding IncludeRemainderEndpoint}" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryText}"
                              ToolTip="仅固定间距模式生效；固定数量模式本身已经包含终点。"/>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="旋转偏移 (Rotation Offset, °):" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RotationOffset, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="注: 默认朝向(0)对齐垂直方向90至-90" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="0,0,8,8" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,1,0,0">
                <Button Content="开始布置 (Start Placement)" Click="StartPlacement_Click" Width="200" Height="32" 
                        Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
