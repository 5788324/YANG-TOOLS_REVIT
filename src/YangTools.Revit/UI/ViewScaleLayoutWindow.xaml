<Window x:Class="YangTools.Revit.UI.ViewScaleLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改比例保排版" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}">
    <StackPanel Margin="18">
        <TextBlock x:Name="CurrentScaleText"/>
        <TextBlock x:Name="SelectionSummary" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
                <Label Content="原排版比例（1:）" Target="{Binding ElementName=OriginalScaleBox}" Foreground="{DynamicResource PrimaryText}"/>
                <TextBox x:Name="OriginalScaleBox" Padding="5" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Label Content="目标比例（1:）" Target="{Binding ElementName=TargetScaleBox}" Foreground="{DynamicResource PrimaryText}"/>
                <TextBox x:Name="TargetScaleBox" Padding="5" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="如果视图已改到目标比例，原排版比例仍填写改之前的值。" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,10"/>
        <CheckBox x:Name="PickAnchorBox" Content="手动点选基准图元（默认用选区左上角）"/>
        <TextBlock x:Name="LegendHint" Text="同一图例放在多张图纸上时，修改比例会影响这些图纸。"
                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="DetailHint" Text="详图构件只移动插入点，请核对出图大小。"
                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock x:Name="ValidationText" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="应用" Width="76" Padding="5" IsDefault="True" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="76" Padding="5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
