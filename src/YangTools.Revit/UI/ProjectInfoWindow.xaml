<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.ProjectInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目文件信息" Height="650" Width="640" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="项目文件信息" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="文件路径、大小与清理预估" Foreground="{DynamicResource TitleText}" FontSize="11" Margin="12,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16">
                <TextBlock Text="基本信息" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Revit 版本" Style="{DynamicResource FieldLabel}"/>
                                <TextBlock x:Name="TxtRevitVersion" Text="加载中…" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="文件名称" Style="{DynamicResource FieldLabel}"/>
                                <TextBlock x:Name="TxtFileName" Text="未保存" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="当前文档路径" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDocPath" Text="加载中…" IsReadOnly="True" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="复制" Width="70" Margin="10,0,0,0" Click="CopyPath_Click"/>
                        </Grid>

                        <StackPanel x:Name="PanelCentralPath" Visibility="Collapsed" Margin="0,0,0,10">
                            <TextBlock Text="中心模型路径" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCentralPath" Text="加载中…" IsReadOnly="True" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="复制" Width="70" Margin="10,0,0,0" Click="CopyCentralPath_Click"/>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,2,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前文件大小" Style="{DynamicResource FieldLabel}"/>
                                <TextBlock x:Name="TxtFileSize" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="最后修改时间" Style="{DynamicResource FieldLabel}"/>
                                <TextBlock x:Name="TxtLastModified" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="清理预估" Style="{DynamicResource SectionTitle}" Margin="0,4,0,8"/>
                <Border Style="{DynamicResource CardBorder}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="检测到的未使用图元" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="TxtUnusedCount" Text="检测中…" Foreground="{DynamicResource WarningColor}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,14">
                            <TextBlock Text="当前大小" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="TxtCurrentSizeCard2" Text="-" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,12,0">
                            <TextBlock Text="清理后预估大小" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="TxtPurgedSize" Text="-" Foreground="{DynamicResource SuccessColor}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="预计节省空间" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock x:Name="TxtSavedSize" Text="-" Foreground="{DynamicResource SuccessColor}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="就绪" Style="{DynamicResource SecondaryLabel}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCalculatePurge" Content="计算清理后大小" Width="132" Style="{DynamicResource PrimaryButton}" Click="BtnCalculatePurge_Click" Margin="0,0,10,0"/>
                    <Button Content="关闭" Width="80" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
