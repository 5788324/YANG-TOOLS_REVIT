<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.CadToRevitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD 转 Revit 图纸" Width="1040" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CAD 转 Revit 图纸" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock x:Name="TxtView" Foreground="{DynamicResource TitleText}" FontSize="10" Opacity="0.82"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="Cancel_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,14,18,8">
            <TextBlock Text="YangCAD 交换文件" Style="{DynamicResource SectionTitle}" Margin="0,0,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSourcePath" IsReadOnly="True" Style="{DynamicResource StandardTextBox}"
                         Text="请选择 YangCAD RVT Exchange JSON" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="选择文件" Width="92" Margin="10,0,0,0"
                        Style="{DynamicResource StandardButton}" Click="Browse_Click"/>
                <Button Grid.Column="2" Content="重新扫描" Width="92" Margin="10,0,0,0"
                        Style="{DynamicResource StandardButton}" Click="Rescan_Click"/>
            </Grid>

            <Border Style="{DynamicResource CardBorder}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="TxtSummary" Text="尚未扫描交换文件。" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSourceInfo" Margin="0,4,0,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TxtMappingStatus" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentColor}" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="18,0,18,8" x:Name="MappingTabs">
            <TabItem Header="文字 / 引线">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="TextGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              SelectionMode="Single" HeadersVisibility="Column" RowHeaderWidth="0" CurrentCellChanged="MappingGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAD 文字类型" Binding="{Binding SourceKey}" Width="2.2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="信息" Binding="{Binding ExtraInfo}" Width="1.3*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="处理方式" Width="160">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Mapping_Changed"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revit 现有/复制模板" Width="2*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" SelectionChanged="Mapping_Changed"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="新类型名称" Binding="{Binding NewTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,7,0,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                               Text="引线跟随文字一起创建，不单独映射。复制/新建文字类型以 Revit 现有类型为模板，不按 CAD H100 等高度硬猜 Revit 字高；CAD 炸开参照仅作备用。"/>
                </Grid>
            </TabItem>

            <TabItem Header="线条">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="LineGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" CurrentCellChanged="MappingGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAD 图层 / 线型" Binding="{Binding SourceKey}" Width="2.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="线宽 / 类型" Binding="{Binding ExtraInfo}" Width="1.3*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="处理方式" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revit 现有/复制模板" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="新线样式名称" Binding="{Binding NewTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.7*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,7,0,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                               Text="普通 Line / Polyline / Arc / Circle 都按 CAD 图层/样式映射到 Revit Line Style。自动新建会优先去掉 White / ByLayer 等 CAD 颜色尾缀。"/>
                </Grid>
            </TabItem>

            <TabItem Header="填充">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="FillGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" CurrentCellChanged="MappingGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAD Hatch / 填充" Binding="{Binding SourceKey}" Width="2.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="处理方式" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revit FilledRegionType / 模板" Width="2.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="新类型名称" Binding="{Binding NewTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.8*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="0,7,0,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                               Text="优先使用项目现有 FilledRegionType。自动新建会复制现有类型；若项目已有与 CAD Hatch 同名的 Drafting FillPattern，会自动套用。复杂 PAT 不在 V1 自动翻译范围。"/>
                </Grid>
            </TabItem>

            <TabItem Header="标注">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="DimensionGrid" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0" CurrentCellChanged="MappingGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAD DimStyle" Binding="{Binding SourceKey}" Width="2.3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="处理方式" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Revit DimensionType / 模板" Width="2.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" SelectionChanged="Mapping_Changed"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="新类型名称" Binding="{Binding NewTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.8*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="尺寸界线专用线样式：" VerticalAlignment="Center" Style="{DynamicResource FieldLabel}"/>
                        <TextBox Grid.Column="1" x:Name="TxtDimensionReferenceStyle" Text="YangTools-尺寸界线" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource SecondaryLabel}"
                                   Text="不存在时自动新建；它只用于标注 Reference，不与普通结构/详图线映射混用。" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,7,0,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                               Text="每个 CAD Dimension 先创建专用 DetailCurve 尺寸界线，再用这些真实几何 Reference 创建 Revit Dimension；失败时该标注与其参考线一起回滚。"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Style="{DynamicResource BottomBar}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存映射" Width="96" Style="{DynamicResource StandardButton}" Click="SaveMappings_Click"/>
                    <TextBlock x:Name="TxtBottomHint" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource SecondaryLabel}"
                               Text="跳过是合法选择；只有未完成的非跳过映射会阻止转换。"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Width="88" Margin="0,0,10,0" Style="{DynamicResource StandardButton}" Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="BtnConvert" Content="开始转换" Width="112" Style="{DynamicResource PrimaryButton}" Click="Convert_Click" IsDefault="True" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
