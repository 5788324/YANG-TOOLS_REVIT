<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.TextModifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本修改" Height="560" Width="520" MinHeight="520" MinWidth="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" MouseLeftButtonDown="Window_MouseDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="文本修改" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="查找、替换和批量格式化文本注释" Foreground="{DynamicResource TitleText}" FontSize="11"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="处理范围" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbScopeSelection" Content="当前选择" IsChecked="True" Margin="0,0,18,0"/>
                        <RadioButton x:Name="RbScopeView" Content="当前视图" Margin="0,0,18,0"/>
                        <RadioButton x:Name="RbScopeProject" Content="整个项目"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="RbModeFindReplace" Content="查找与替换" IsChecked="True" Checked="Mode_Changed" Margin="0,0,18,0"/>
                <RadioButton x:Name="RbModeFormat" Content="格式化" Checked="Mode_Changed"/>
            </StackPanel>

            <Border x:Name="PanelFindReplace" Grid.Row="2" Style="{DynamicResource CardBorder}" Margin="0" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="查找内容" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtFind" Margin="0,0,0,14"/>
                    <TextBlock Text="替换为" Style="{DynamicResource FieldLabel}" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtReplace" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkMatchCase" Content="区分大小写" Margin="0,0,18,0"/>
                        <CheckBox x:Name="ChkWholeWord" Content="全词匹配"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PanelFormat" Grid.Row="2" Style="{DynamicResource CardBorder}" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbFormats"/>
                        <Button Grid.Column="1" Content="添加" Width="74" Margin="10,0,0,0" Click="BtnAddFormat_Click"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="LstOperations" Margin="0,0,10,0" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayName}" Padding="5"/></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1">
                            <Button Content="上移" Margin="0,0,0,8" Click="BtnMoveUp_Click"/>
                            <Button Content="下移" Margin="0,0,0,8" Click="BtnMoveDown_Click"/>
                            <Button Content="移除" Click="BtnRemove_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <Grid>
                <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource SuccessColor}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="82" Margin="0,0,10,0" Click="CloseButton_Click"/>
                    <Button x:Name="BtnConfirm" Content="执行" Width="90" Style="{DynamicResource PrimaryButton}" Click="BtnExecute_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
