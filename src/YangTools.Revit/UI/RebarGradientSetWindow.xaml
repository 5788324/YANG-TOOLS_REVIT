<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.RebarGradientSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="渐变钢筋集"
        Width="920" Height="760" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="渐变钢筋集" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="根据首末控制钢筋生成渐变钢筋集"
                               Foreground="{DynamicResource TitleText}" FontSize="10" Opacity="0.82"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="Close_Click"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Style="{DynamicResource StandardScrollViewer}">
            <StackPanel Margin="18,16,18,14">
                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="1. 控制钢筋" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="起始控制筋" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding StartControlText}" IsReadOnly="True"
                                     Style="{DynamicResource StandardTextBox}" Margin="0,0,10,0"/>
                            <Button Grid.Column="2" Content="拾取钢筋" Style="{DynamicResource StandardButton}"
                                    Click="PickStartControl_Click"/>

                            <TextBlock Grid.Row="1" Text="结束控制筋" Style="{DynamicResource FieldLabel}"
                                       VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EndControlText}" IsReadOnly="True"
                                     Style="{DynamicResource StandardTextBox}" Margin="0,10,10,0"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="拾取钢筋" Style="{DynamicResource StandardButton}"
                                    Margin="0,10,0,0" Click="PickEndControl_Click"/>
                            <Button Grid.Column="3" Grid.RowSpan="2" Content="⇅ 交换首末" Width="82" Height="34"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Style="{DynamicResource StandardButton}" Click="SwapControls_Click"/>
                        </Grid>
                        <TextBlock Text="控制筋只作为首末几何模板；最终钢筋集会重新包含第一根和最后一根，不修改原控制筋。"
                                   Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="2. 分布基准" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="104"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="基准类型" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PathKindCombo" Grid.Column="1" Style="{DynamicResource StandardComboBox}"
                                      SelectedIndex="0" SelectionChanged="PathKindCombo_SelectionChanged">
                                <ComboBoxItem Content="全局 Z 轴" Tag="ZAxis"/>
                                <ComboBoxItem Content="模型线" Tag="ModelLine"/>
                                <ComboBoxItem Content="模型 Edge" Tag="Edge"/>
                            </ComboBox>
                            <TextBox Grid.Column="2" Text="{Binding PathText}" IsReadOnly="True"
                                     Style="{DynamicResource StandardTextBox}" Margin="10,0"/>
                            <Button x:Name="PickPathButton" Grid.Column="3" Content="拾取基准" Style="{DynamicResource StandardButton}"
                                    Click="PickPath_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="布置方向" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DirectionText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="有效长度" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding EffectiveLengthText}" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="ModelLine / Edge 只提供分布轴线和可用范围；业务方向统一由“起始控制筋 → 结束控制筋”决定。Zone[0] 永远从起始控制筋一侧开始；交换首末即可反向。"
                                   Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="3. 分布区段" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="+ 普通区" Width="86" Style="{DynamicResource StandardButton}" Click="AddNormalZone_Click"/>
                                <Button Content="+ 加密区" Width="86" Margin="8,0,0,0" Style="{DynamicResource StandardButton}" Click="AddDenseZone_Click"/>
                                <Button Content="删除" Width="68" Margin="8,0,0,0" Style="{DynamicResource StandardButton}" Click="RemoveZone_Click"/>
                                <Button Content="↑" Width="40" Margin="8,0,0,0" Style="{DynamicResource StandardButton}" Click="MoveZoneUp_Click"/>
                                <Button Content="↓" Width="40" Margin="6,0,0,0" Style="{DynamicResource StandardButton}" Click="MoveZoneDown_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="0,9,0,8" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                                   Text="默认保留 1 个“自动剩余”普通区：其长度=有效分布长度−其余固定区段。新增加密/普通区后会自动扣减；新行会插入到当前选中行之后。最多只能有 1 个自动区。"/>

                        <DataGrid x:Name="ZoneGrid" Grid.Row="2" ItemsSource="{Binding Zones}"
                                  Style="{DynamicResource SharedDataGridStyle}"
                                  ColumnHeaderStyle="{DynamicResource SharedDataGridColumnHeaderStyle}"
                                  SelectionMode="Single" RowHeaderWidth="0"
                                  PreviewMouseWheel="ZoneGrid_PreviewMouseWheel"
                                  BeginningEdit="ZoneGrid_BeginningEdit"
                                  CellEditEnding="ZoneGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="88"/>
                                <DataGridTemplateColumn Header="长度模式" Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsAutoLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{Binding LengthModeText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="长度(mm)" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LengthDisplayText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding LengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding IsFixedLength}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="最大间距(mm)" Binding="{Binding MaxSpacingMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Width="116"/>
                                <DataGridTextColumn Header="手动间距(mm)" Binding="{Binding ManualActualSpacingMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="112"/>
                                <DataGridTextColumn Header="实际间距(mm)" Binding="{Binding PreviewMainSpacingMm, StringFormat=0.###}" Width="112" IsReadOnly="True"/>
                                <DataGridTextColumn Header="尾差(mm)" Binding="{Binding PreviewTailSpacingMm, StringFormat=0.###}" Width="86" IsReadOnly="True"/>
                                <DataGridTextColumn Header="间隔" Binding="{Binding PreviewIntervalCount}" Width="64" IsReadOnly="True"/>
                                <DataGridTextColumn Header="预览" Binding="{Binding PreviewText}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ZoneTotalText" Text="固定区段：0 mm · 自动剩余：待计算" Style="{DynamicResource SecondaryLabel}"/>
                                <TextBlock Grid.Column="1" Text="自动：均匀分配且实际间距 ≤ 最大间距 · 手动间距允许尾差"
                                           Style="{DynamicResource SecondaryLabel}"/>
                            </Grid>
                            <TextBlock Text="{Binding InputValidationText}" Foreground="{DynamicResource AccentColor}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource CardBorder}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="4. 预览结果" Style="{DynamicResource SectionTitle}" Margin="0,0,0,7"/>
                            <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HostAndTypeText}" Style="{DynamicResource SecondaryLabel}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Foreground="{DynamicResource AccentColor}"/>
                        </StackPanel>
                        <Button x:Name="PreviewButton" Grid.Column="1" Content="计算预览" Width="112" Height="38"
                                VerticalAlignment="Center" Style="{DynamicResource StandardButton}"
                                Click="Preview_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="生成方式：Managed FreeForm（ManagedGeometry）；不会冒充 Revit Native ToCover。"
                           Style="{DynamicResource SecondaryLabel}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CreateButton" Content="创建钢筋集" Width="116" Height="36"
                            Style="{DynamicResource PrimaryButton}" IsEnabled="False"
                            Click="Create_Click"/>
                    <Button Content="关闭" Width="88" Height="36" Margin="10,0,0,0"
                            Style="{DynamicResource StandardButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
