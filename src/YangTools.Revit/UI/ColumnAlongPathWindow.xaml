<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.ColumnAlongPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沿线布柱"
        Width="500" Height="690"
        MinWidth="460" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarGradient}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="沿线布柱"
                               Style="{DynamicResource WindowTitle}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="34" Height="34"
                            Margin="0,0,8,0"
                            Style="{DynamicResource IconButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource TitleText}"
                                   FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <Border Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource WindowBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. 路线" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left"
                                        Content="选择连续模型线"
                                        Style="{DynamicResource StandardButton}"
                                        Click="PickRoute_Click"
                                        Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding TotalLengthDisplay}"
                                           Foreground="{DynamicResource AccentColor}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding PathInfoText}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource WindowBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="2. 柱类型与布置" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="柱类型" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableColumnTypes}"
                                      SelectedItem="{Binding SelectedColumnType}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{DynamicResource StandardComboBox}"
                                      IsTextSearchEnabled="True"
                                      Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="固定间距（mm）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SpacingMm, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="首柱距路线起点（mm）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding StartOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="路线起点里程（m）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RouteStartMileageM, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="旋转偏移角度（°）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RotationOffsetDegrees, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="柱默认沿路线切线旋转；0° 表示族本地 X 轴沿路线，90° 可让族方向与路线垂直。里程仅用于结果中的 K 桩号计算。"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <CheckBox Content="反转路线首尾"
                                      IsChecked="{Binding ReversePath}"
                                      Style="{DynamicResource StandardCheckBox}"/>
                            <CheckBox Content="末尾不足一个间距时，在路线终点补放一根柱"
                                      IsChecked="{Binding IncludeEndColumn}"
                                      Style="{DynamicResource StandardCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBg}"
                            BorderBrush="{DynamicResource WindowBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="3. 柱约束" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Base Level" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableLevels}"
                                              SelectedItem="{Binding SelectedBaseLevel}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{DynamicResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Base Offset（mm）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding BaseOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Top Level" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableLevels}"
                                              SelectedItem="{Binding SelectedTopLevel}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{DynamicResource StandardComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Top Offset（mm）" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding TopOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource StandardTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource WindowBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                    <Button Content="关闭"
                            Style="{DynamicResource StandardButton}"
                            Click="CloseButton_Click"
                            Width="82"
                            Margin="0,0,8,0"/>
                    <Button Content="开始布置"
                            Style="{DynamicResource PrimaryButton}"
                            Click="StartPlacement_Click"
                            Width="110"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
