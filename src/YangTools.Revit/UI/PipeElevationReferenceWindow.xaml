<controls:YangWindow x:Class="YangTools.Revit.UI.PipeElevationReferenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YangTools.Revit.UI.Controls"
        Title="管道高程基准转换" Subtitle="中心高度 · 管内底 · 管外底 · 管内顶 · 管外顶"
        Width="490" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>

        <Border Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="当前高程基准（原数值代表）：" Style="{DynamicResource FieldLabel}" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="SourceRefCombo" SelectionChanged="Reference_Changed"/>
            </Grid>
        </Border>

        <Border Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="目标高程基准（保持标高数值不变，转换后该位置等于原数值）：" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,8"/>
                <RadioButton x:Name="RbCenter" Content="中心高度（Center）" Margin="0,3" Checked="Reference_Changed"/>
                <RadioButton x:Name="RbInvert" Content="管内底（Inner Bottom / Invert）— 推荐给排水" IsChecked="True" Margin="0,3" Checked="Reference_Changed"/>
                <RadioButton x:Name="RbBottom" Content="管外底（Outer Bottom）" Margin="0,3" Checked="Reference_Changed"/>
                <RadioButton x:Name="RbInnerTop" Content="管内顶（Inner Top）" Margin="0,3" Checked="Reference_Changed"/>
                <RadioButton x:Name="RbOuterTop" Content="管外顶（Outer Top）" Margin="0,3" Checked="Reference_Changed"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="ChkIncludeInsulation" Content="管外底 / 管外顶计入保温层厚度" Margin="0,2"/>
        <CheckBox x:Name="ChkDeleteBlockingFittings" Content="弯头等管件连接无法保留时自动删除阻挡管件" IsChecked="True" Margin="0,4,0,10"/>

        <TextBlock x:Name="HintText" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="示例：当前「中心高度」= 1200 mm，转换为「管内底」后管道上移 +内径/2，使管内底 = 1200 mm。支持单次 Ctrl+Z 撤销。"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ApplyButton" Content="应用" Style="{DynamicResource PrimaryButton}" Width="88" IsDefault="True" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Style="{DynamicResource StandardButton}" Width="88" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</controls:YangWindow>
