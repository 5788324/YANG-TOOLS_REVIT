<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.SimpleFamilyMaterialBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绑定材质" Width="590" Height="430" MinWidth="540" MinHeight="400"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="绑定材质" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock x:Name="SelectionSummaryText" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="参数名称：" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="ParameterNameBox" Grid.Column="1" Height="34" Padding="8,2"
                     VerticalContentAlignment="Center" Text="材质"
                     ToolTip="在族中创建或复用的 Material 类型族参数名称"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="参数方式：" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="InstanceParameterRadio" Content="实例参数" IsChecked="True" Margin="0,0,24,0"/>
                <RadioButton x:Name="TypeParameterRadio" Content="类型参数"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="赋予材质：" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <ComboBox x:Name="MaterialBox" Grid.Column="1" Height="34" Padding="6,1"
                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      DisplayMemberPath="Name" TextSearch.TextPath="Name"
                      ToolTip="搜索并选择当前项目中已经存在的材质；本工具不会自动新建材质"/>
        </Grid>

        <CheckBox x:Name="RebindExistingCheckBox" Grid.Row="4" IsChecked="True" Margin="0,0,0,12"
                  Content="覆盖族几何已有的其它材质参数绑定"/>

        <Border Grid.Row="5" Padding="10" Margin="0,0,0,14" CornerRadius="4"
                BorderBrush="{DynamicResource InputBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                           Text="实例参数：只给当前选中的实例赋材质。类型参数：给所选实例对应的族类型赋材质，同类型的其它实例也会一起变化。"/>
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap"
                           Text="只支持可编辑载入族。内建族、不可编辑族、同名但非材质参数等会安全跳过/失败。材质必须已经存在于当前项目。"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="重新选择实例" Width="112" Height="32" Click="Reselect_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="取消" Width="82" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="绑定并赋予" Width="106" Height="32" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
