<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.ChineseCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目中文检查与清理" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="项目中文检查与清理" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="分类扫描 · 定位 · 双击重命名 · 安全删除/清空"
                               Foreground="{DynamicResource TitleText}" FontSize="11" Margin="12,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="?" Width="30" Height="28" Margin="0,0,6,0"
                        Style="{DynamicResource StandardButton}" ToolTip="功能说明" Click="HelpButton_Click"/>
                <Button Grid.Column="2" Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,12,14,0" Style="{DynamicResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="搜索" VerticalAlignment="Center" Style="{DynamicResource SecondaryLabel}" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" ToolTip="筛选当前分类中的名称、内容、所属与类型"/>
                <Button Grid.Column="3" Content="全选" Width="70" Click="BtnSelectAll_Click"/>
                <Button Grid.Column="4" Content="全不选" Width="76" Margin="8,0,0,0" Click="BtnSelectNone_Click"/>
                <Button Grid.Column="5" Content="反选" Width="70" Margin="8,0,0,0" Click="BtnInvertSelection_Click"/>
                <TextBlock x:Name="SelectionSummaryText" Grid.Column="6" VerticalAlignment="Center"
                           Margin="16,0,0,0" Style="{DynamicResource SecondaryLabel}" Text="当前分类 0 条；已勾选 0 条"/>
                <Button Grid.Column="7" Content="重新扫描" Width="92" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,10,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="中文结果分类" Style="{DynamicResource SectionTitle}"/>
                        <TextBlock x:Name="TotalCountText" HorizontalAlignment="Right" Style="{DynamicResource SecondaryLabel}"/>
                    </Grid>
                    <ListBox x:Name="GroupList" Grid.Row="1" SelectionChanged="GroupList_SelectionChanged"
                             BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
                             Background="{DynamicResource WindowBg}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,5" MinWidth="205">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                                        <TextBlock Text="{Binding Section}" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" Foreground="{DynamicResource SecondaryText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="CurrentGroupTitle" Text="请选择分类" Style="{DynamicResource SectionTitle}"/>
                            <TextBlock Text="勾选用于批量操作；双击“名称 / 内容”可以重命名或修改可编辑文本。"
                                       Margin="0,3,0,0" Style="{DynamicResource SecondaryLabel}"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ResultGrid" Grid.Row="1" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              BeginningEdit="ResultGrid_BeginningEdit" CellEditEnding="ResultGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="√" Width="38" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称 / 内容（双击修改）" Width="2.2*"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
                            <DataGridTextColumn Header="所属 / 说明" Width="1.5*" IsReadOnly="True" Binding="{Binding Owner}"/>
                            <DataGridTextColumn Header="类型" Width="112" IsReadOnly="True" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="Element ID" Width="92" IsReadOnly="True" Binding="{Binding IdText}"/>
                            <DataGridCheckBoxColumn Header="可改名" Width="68" IsReadOnly="True" Binding="{Binding CanRename}"/>
                            <DataGridCheckBoxColumn Header="可删除" Width="68" IsReadOnly="True" Binding="{Binding CanDelete}"/>
                            <DataGridTextColumn Header="风险" Width="60" IsReadOnly="True" Binding="{Binding RiskText}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ActionHintText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{DynamicResource SecondaryLabel}"
                                   Text="高风险删除会先预检级联影响，再要求二次确认；参数文本值的“删除”实际为清空。"/>
                        <Button Grid.Column="1" Content="在 Revit 中选择" Width="118" Click="BtnSelectElements_Click"/>
                        <Button Grid.Column="2" Content="复制 ID" Width="82" Margin="8,0,0,0" Click="BtnCopyIds_Click"/>
                        <Button Grid.Column="3" Content="取消编辑" Width="82" Margin="8,0,0,0" Click="BtnCancelEdit_Click"/>
                        <Button Grid.Column="4" Content="删除 / 清空所选" Width="118" Margin="8,0,0,0"
                                Style="{DynamicResource DangerButton}" Click="BtnDeleteSelected_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{DynamicResource BottomBar}">
            <Grid>
                <TextBlock x:Name="SummaryText" Text="准备扫描" Style="{DynamicResource SecondaryLabel}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,210,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="功能说明" Width="92" Margin="0,0,10,0" Click="HelpButton_Click"/>
                    <Button Content="关闭" Width="82" Style="{DynamicResource PrimaryButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
