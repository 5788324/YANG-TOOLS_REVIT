<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Height="550" Width="680"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" WindowStyle="None"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Name="Border" Padding="15,10" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1,1,1,0" Margin="2,0,2,0" CornerRadius="4,4,0,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource WindowBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="{DynamicResource TitleBarGradient}">
                <Grid>
                    <TextBlock Text="系统设置" Foreground="{DynamicResource TitleText}" VerticalAlignment="Center" Margin="15,0" FontWeight="Bold" FontSize="14"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Width="30" Height="24" Content="✕" Foreground="{DynamicResource TitleText}" BorderThickness="0"
                            Click="CloseButton_Click" FontSize="14" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- TabControl -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10" Background="Transparent" BorderBrush="{DynamicResource BtnBorder}" BorderThickness="0,1,0,0">
                <!-- Tab 0: 界面设置 (Theme + Ribbon) -->
                <TabItem Header="界面设置">
                    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Theme Selector -->
                            <TextBlock Text="主题配色" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ThemeList" Margin="0,0,0,15">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="140" Height="75" Margin="4" Cursor="Hand"
                                                Background="{DynamicResource PanelBg}" 
                                                BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                                                CornerRadius="5" MouseLeftButtonDown="Theme_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="44" Height="24" CornerRadius="3" Margin="0,0,0,6"
                                                        Background="{Binding PreviewColor}"/>
                                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryText}"
                                                           FontSize="12" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryText}"
                                                           FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 1: 面板设置 -->
                <TabItem Header="面板设置">
                    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Ribbon 面板可见性" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Text="勾选的功能显示在面板主区；未勾选的功能进入该面板的展开区。系统设置固定显示，避免配置后无法恢复。" 
                                       Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="当前面板全选" Width="108" Margin="0,0,8,4" Click="SelectCurrentPanel_Click"/>
                                <Button Content="当前面板恢复默认" Width="132" Margin="0,0,8,4" Click="RestoreCurrentPanel_Click"/>
                                <Button Content="全部面板恢复默认" Width="132" Margin="0,0,8,4" Click="RestoreAllPanels_Click"/>
                            </WrapPanel>
                            <TabControl x:Name="PanelTabControl" 
                                        Background="{DynamicResource InputBg}" 
                                        BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1"
                                        MinHeight="200"/>
                            <Button x:Name="BtnSavePanel" Content="保存面板设置" Width="140" Height="32" Margin="0,12,0,0"
                                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentText}"
                                    BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                    Click="BtnSavePanel_Click"/>
                            <TextBlock Text="关闭窗口不会保存面板改动；只有点击“保存面板设置”才会写入。重启 Revit 后生效。" 
                                       Foreground="{DynamicResource WarningColor}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 关于 -->
                <TabItem Header="关于">
                    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,12,18,20">
                            <TextBlock Text="YangTools" Foreground="{DynamicResource PrimaryText}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Revit Productivity &amp; Automation Toolkit" Foreground="{DynamicResource SecondaryText}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,16"/>

                            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="版本" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock x:Name="VersionText" Grid.Column="1" Text="4.0.0" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="原作者" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Yang" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Text="版权" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Copyright © 2026 Yang" Foreground="{DynamicResource PrimaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Text="许可" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="非商业署名许可" Foreground="{DynamicResource PrimaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Text="发布签名" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock x:Name="SignatureText" Grid.Row="4" Grid.Column="1" Text="正在读取" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Text="Revit" Foreground="{DynamicResource SecondaryText}" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="2021–2027 独立编译；运行支持以各版本验收记录为准" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap" Margin="0,3"/>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="许可摘要" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                    <TextBlock Text="允许：免费使用、复制、公开分发、修改和二次开发。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2"/>
                                    <TextBlock Text="要求：保留 YangTools 原始项目名称、原作者 Yang、版权与许可声明。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2"/>
                                    <TextBlock Text="禁止：未经原作者授权的商业使用、销售、付费分发或收费集成。" Foreground="{DynamicResource WarningColor}" TextWrapping="Wrap" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="第三方组件仍分别受其原许可证约束。详细条款见安装目录 Docs/LICENSE.md、NOTICE.md 与 THIRD_PARTY_NOTICES.md。"
                                       Foreground="{DynamicResource SecondaryText}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="6,12,6,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: MCP 与执行服务 -->
                <TabItem Header="MCP与执行服务">
                    <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Revit 执行器" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="状态" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock x:Name="ExecutionStatusText" Grid.Column="1" Text="正在读取" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Python" Foreground="{DynamicResource SecondaryText}" Margin="18,0,0,0"/>
                                    <TextBlock x:Name="PythonStatusText" Grid.Column="3" Text="正在读取"/>
                                    <TextBlock Grid.Row="1" Text="待处理" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="PendingCountText" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,7,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="正在执行" Foreground="{DynamicResource SecondaryText}" Margin="18,7,0,0"/>
                                    <TextBlock x:Name="CurrentCommandText" Grid.Row="1" Grid.Column="3" Text="无" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="最近结果" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="ExecutionLastResultText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="无" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="外部 MCP 网关" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse x:Name="McpStatusIndicator" Width="12" Height="12" Fill="{DynamicResource DisabledText}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="McpStatusText" Text="MCP 网关已关闭" FontSize="15" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <TextBlock Text="连接地址" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox x:Name="McpUrlTextBox" Text="未启动" IsReadOnly="True" Margin="0,4,0,8"/>
                                    <TextBlock Text="会话令牌" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox x:Name="McpTokenTextBox" Text="未生成" IsReadOnly="True" Margin="0,4,0,8"/>
                                    <TextBlock Text="实例发现文件" Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBox x:Name="McpInstanceFileTextBox" Text="未生成" IsReadOnly="True" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                    <CheckBox x:Name="McpAutoStartCheck" Content="随 Revit 启动外部 MCP 网关" Margin="0,0,0,5" Checked="McpSettingsChanged" Unchecked="McpSettingsChanged"/>
                                    <CheckBox x:Name="McpAllowPythonCheck" Content="允许受信任的本机 MCP 客户端执行 Revit Python" Checked="McpSettingsChanged" Unchecked="McpSettingsChanged"/>
                                    <TextBlock Text="默认关闭。启用 Python 后，本机持有当前会话令牌的客户端才能请求执行。" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource SecondaryText}" Margin="20,4,0,10"/>

                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="启动" Width="72" Margin="0,0,7,7" Click="StartMcp_Click"/>
                                        <Button Content="停止" Width="72" Margin="0,0,7,7" Click="StopMcp_Click"/>
                                        <Button Content="重启" Width="72" Margin="0,0,7,7" Click="RestartMcp_Click"/>
                                        <Button Content="复制连接配置" Width="110" Margin="0,0,7,7" Click="CopyMcpConfig_Click"/>
                                        <Button Content="自检" Width="72" Margin="0,0,7,7" Click="TestMcp_Click"/>
                                    </WrapPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="最后请求" Foreground="{DynamicResource SecondaryText}"/>
                                        <TextBlock x:Name="McpLastRequestText" Grid.Column="1" Text="无" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Row="1" Text="最后命令" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="McpLastCommandText" Grid.Row="1" Grid.Column="1" Text="无" Margin="12,6,0,0"/>
                                        <TextBlock Grid.Row="2" Text="耗时" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="McpLastDurationText" Grid.Row="2" Grid.Column="1" Text="-" Margin="12,6,0,0"/>
                                        <TextBlock Grid.Row="3" Text="最近错误" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="McpLastErrorText" Grid.Row="3" Grid.Column="1" Text="无" Margin="12,6,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
