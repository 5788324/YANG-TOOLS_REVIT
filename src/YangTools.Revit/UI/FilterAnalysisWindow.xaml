<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.FilterAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="过滤器分析" Height="550" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="FilterNameText" Text="过滤器: [Name]" FontSize="15" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="A. 控制的类别 (Categories)" FontWeight="Bold" Margin="0,8,0,4"/>
                <ListBox x:Name="CategoriesListBox" MaxHeight="120"/>

                <TextBlock Text="B. 匹配的模型图元 (Elements)" FontWeight="Bold" Margin="0,8,0,4"/>
                <DataGrid x:Name="ElementsDataGrid" AutoGenerateColumns="False" MaxHeight="150" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="C. 使用此过滤器的视图/图纸" FontWeight="Bold" Margin="0,8,0,4"/>
                <ListBox x:Name="ViewsListBox" MaxHeight="120"/>

                <TextBlock Text="D. 过滤规则详情 (Filter Rules)" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBox x:Name="FilterRulesTextBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

                <TextBlock x:Name="FilterSummaryText" Text="分析完成" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="关闭 (Close)" Width="100" Margin="0,10,0,0" Click="Close_Click"/>
    </Grid>
</Window>
