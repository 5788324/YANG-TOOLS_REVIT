<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.PasteCadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从 CAD 粘贴" Height="610" Width="700" MinHeight="570" MinWidth="640"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="从 CAD 粘贴" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock x:Name="TxtActiveView" Text="当前视图" Foreground="{DynamicResource TitleText}"
                               FontSize="10" Opacity="0.82"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CancelButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource StandardScrollViewer}">
            <StackPanel Margin="18,16,18,8">
                <Border x:Name="BdrStatus" Style="{DynamicResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatusIcon" Text="…" FontSize="22"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtStatusTitle" Text="正在检测 AutoCAD 剪贴板"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="TxtStatusDesc" Text="请稍候…" Style="{DynamicResource SecondaryLabel}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="DWG 来源" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CboCadFiles" Style="{DynamicResource StandardComboBox}"
                              DisplayMemberPath="DisplayText" SelectionChanged="CboCadFiles_SelectionChanged"/>
                    <Button Grid.Column="1" Content="重新检测" Width="96" Margin="10,0,0,0"
                            Style="{DynamicResource StandardButton}" Click="BtnRedetect_Click"/>
                    <Button Grid.Column="2" Content="选择文件" Width="96" Margin="10,0,0,0"
                            Style="{DynamicResource StandardButton}" Click="BtnBrowse_Click"/>
                    <Button Grid.Column="3" Content="清理缓存" Width="96" Margin="10,0,0,0"
                            Style="{DynamicResource StandardButton}" Click="BtnCleanupCache_Click"
                            ToolTip="清理 YangTools 导入工作副本；可选清理 24 小时前的 AutoCAD A$C 临时 DWG"/>
                </Grid>

                <TextBox x:Name="TxtSelectedFile" IsReadOnly="True" Text="尚未选择 DWG 文件"
                         Style="{DynamicResource StandardTextBox}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="导入设置" Style="{DynamicResource SectionTitle}" Margin="0,0,0,10"/>
                <Border Style="{DynamicResource CardBorder}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="导入单位" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox x:Name="CboUnits" Grid.Row="0" Grid.Column="1"
                                  Style="{DynamicResource StandardComboBox}" Margin="0,0,0,10">
                            <ComboBoxItem>自动检测</ComboBoxItem>
                            <ComboBoxItem>毫米 (mm)</ComboBoxItem>
                            <ComboBoxItem>厘米 (cm)</ComboBoxItem>
                            <ComboBoxItem>分米 (dm)</ComboBoxItem>
                            <ComboBoxItem>米 (m)</ComboBoxItem>
                            <ComboBoxItem>英寸 (inch)</ComboBoxItem>
                            <ComboBoxItem>英尺 (foot)</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="颜色模式" Style="{DynamicResource FieldLabel}"/>
                        <ComboBox x:Name="CboColors" Grid.Row="1" Grid.Column="1"
                                  Style="{DynamicResource StandardComboBox}" Margin="0,0,0,10">
                            <ComboBoxItem>保留颜色</ComboBoxItem>
                            <ComboBoxItem>黑白模式</ComboBoxItem>
                            <ComboBoxItem>反转颜色</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="定位方式" Style="{DynamicResource FieldLabel}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="CboPlacement"
                                      Style="{DynamicResource StandardComboBox}"
                                      SelectionChanged="CboPlacement_SelectionChanged">
                                <ComboBoxItem>原点到原点</ComboBoxItem>
                                <ComboBoxItem>中心到中心</ComboBoxItem>
                                <ComboBoxItem>对齐共享坐标</ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="TxtPlacementHint" Margin="0,5,0,0"
                                       Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="导入范围" Style="{DynamicResource FieldLabel}"/>
                        <CheckBox x:Name="ChkThisViewOnly" Grid.Row="3" Grid.Column="1"
                                  Content="仅当前视图" Style="{DynamicResource StandardCheckBox}"/>

                        <TextBlock x:Name="TxtViewOnlyHint" Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                   Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="导入工作副本会自动清理；AutoCAD 自己生成的 A$C 临时文件只在手动确认后清理。"
                           Style="{DynamicResource SecondaryLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Width="90" Margin="0,0,10,0" Style="{DynamicResource StandardButton}"
                            Click="CancelButton_Click" IsCancel="True"/>
                    <Button x:Name="BtnConfirm" Content="导入" IsEnabled="False" Width="90" Style="{DynamicResource PrimaryButton}"
                            Click="BtnConfirm_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
