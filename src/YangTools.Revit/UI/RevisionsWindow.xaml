<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.RevisionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择修订" Height="380" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Microsoft YaHei UI" WindowStyle="None" AllowsTransparency="True"
        BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">

    <Window.Resources>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" CornerRadius="8,8,0,0">
            <TextBlock Text="选择修订 (Select Revisions)" Foreground="{DynamicResource TitleText}" VerticalAlignment="Center" Margin="15,0" FontWeight="Bold" FontSize="14"/>
        </Border>

        <ListBox x:Name="RevisionsList" Grid.Row="1" Margin="10"
                 Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BtnBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{DynamicResource BottomBarBg}" CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                <Button Content="确定 (OK)" Style="{StaticResource FlatBtn}" Click="OkButton_Click" Margin="0,0,10,0"/>
                <Button Content="取消 (Cancel)" Style="{StaticResource FlatBtn}" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
