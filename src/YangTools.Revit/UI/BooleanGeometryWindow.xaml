<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.BooleanGeometryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="布尔几何" Height="425" Width="620" MinHeight="425" MinWidth="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" MouseDown="Window_MouseDown">
    <Window.Resources>

        <Style x:Key="StandardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="15,5">
                            <TextBlock Text="X" FontSize="14" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="{DynamicResource TitleBarGradient}">
                <Grid>
                    <TextBlock Text="布尔几何" Foreground="{DynamicResource TitleText}" FontSize="14" FontWeight="Bold" Margin="15,10" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Source & Target -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="4" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="选择主体实例" Style="{StaticResource StandardButtonStyle}" Click="BtnSelectMain_Click" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtMain" Grid.Column="1" Text="未选择" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="选择融合实例" Style="{StaticResource StandardButtonStyle}" Click="BtnSelectUnion_Click" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtUnion" Grid.Column="1" Text="未选择" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="选择剪切实例" Style="{StaticResource StandardButtonStyle}" Click="BtnSelectCut_Click" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtCut" Grid.Column="1" Text="未选择" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="选择连接实例" Style="{StaticResource StandardButtonStyle}" Click="BtnSelectJoin_Click" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtJoin" Grid.Column="1" Text="未选择" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Options -->
                <TextBlock Grid.Row="3" Text="选项" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                <StackPanel Grid.Row="4">
                    <CheckBox x:Name="ChkDeleteTargetInst" Content="删除目标图元 (Delete Target Instance)"/>
                    <CheckBox x:Name="ChkDeleteTargetFam" Content="删除目标族定义（会删除该族的所有项目实例）" ToolTip="仅当项目中该族的全部实例都已选入目标时才允许删除；其他依赖仍需用户确认。"/>
                    <TextBlock Text="执行顺序：融合 → 剪切 → 连接。默认保留全部刀具；勾选删除目标会删除所选实例。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="{DynamicResource BottomBarBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="15,10">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource StandardButtonStyle}" Margin="0,0,10,0" Click="CloseButton_Click"/>
                        <Button Content="执行 (Execute)" Style="{StaticResource PrimaryButtonStyle}" Click="BtnExecute_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
