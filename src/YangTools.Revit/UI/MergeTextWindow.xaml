<Window x:Class="YangTools.Revit.UI.MergeTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本合并"
        Width="470" MinWidth="440" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="文本合并" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="按指定顺序将多个文本合并到第一个文本" Foreground="{DynamicResource TitleText}" FontSize="11"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,16,18,12">
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="文本选择" Style="{DynamicResource SectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtSelectionStatus" Text="未选择文本" Foreground="{DynamicResource DangerBg}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="选择文本" MinWidth="92" Height="32"
                            Style="{DynamicResource StandardButton}" Click="BtnSelectTexts_Click"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="合并顺序" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="RbReadingOrder" Content="智能阅读顺序：同一行从左到右，逐行从上到下" Tag="ReadingOrder" IsChecked="True" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbSelectionOrder" Content="按选择顺序" Tag="SelectionOrder" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbXDesc" Content="按 X 坐标降序（从右到左）" Tag="XDesc" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbXAsc" Content="按 X 坐标升序（从左到右）" Tag="XAsc" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbYDesc" Content="按 Y 坐标降序（从上到下）" Tag="YDesc" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbYAsc" Content="按 Y 坐标升序（从下到上）" Tag="YAsc"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="合并选项" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkCleanWhitespace" Content="删除原文字中多余换行、Tab 和重复空格" IsChecked="True" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkUseNewline" Content="以换行符分隔" Checked="ChkNewline_Changed" Unchecked="ChkNewline_Changed" Margin="0,0,0,8"/>
                    <Grid x:Name="SeparatorPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="自定义分隔符" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSeparator" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="82" Margin="0,0,10,0" Style="{DynamicResource StandardButton}" Click="BtnCancel_Click"/>
                <Button Content="执行合并" Width="100" Style="{DynamicResource PrimaryButton}" Click="BtnExecute_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
