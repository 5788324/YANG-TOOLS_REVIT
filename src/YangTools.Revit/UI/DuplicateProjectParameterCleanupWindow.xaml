<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.DuplicateProjectParameterCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重复项目参数清理"
        Width="1220" Height="800" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="重复项目参数清理" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="按参数 ID 原位合并绑定和值，清理同名重复项目参数"
                               Foreground="{DynamicResource TitleText}" FontSize="11" Margin="12,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,12,14,0" Style="{DynamicResource CardBorder}" Padding="12">
            <StackPanel>
                <TextBlock Text="建议先另存 RVT 副本。工具保留一个原参数并合并其他同名参数；不会采用全部删除重建，也不会用显示字符串转存数值。"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="删除时允许 Revit 预先报告的参数伴随对象；只有未预期级联对象才回滚定位，不影响其他参数继续处理。"
                           Style="{DynamicResource SecondaryLabel}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,10,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="1. 扫描重复参数" Width="132" Margin="0,0,8,6" Click="ScanButton_Click"/>
                <Button x:Name="MergeButton" Content="2. 仅合并绑定和值" Width="145" Margin="0,0,8,6" Click="MergeButton_Click" IsEnabled="False"/>
                <Button x:Name="QuickButton" Content="快速处理：合并并清理" Width="168" Margin="0,0,8,6"
                        Style="{DynamicResource PrimaryButton}" Click="QuickButton_Click" IsEnabled="False"/>
                <Button x:Name="DeleteButton" Content="3. 仅删除可删除项" Width="145" Margin="0,0,8,6" Click="DeleteButton_Click" IsEnabled="False"/>
                <Button x:Name="ReportButton" Content="打开 CSV 报告" Width="116" Margin="0,0,8,6" Click="ReportButton_Click" IsEnabled="False"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AllowDeleteSharedCheckBox" Content="允许删除共享参数（高风险）"
                          Margin="12,0,12,6"/>
                <CheckBox x:Name="DeleteConflictsCheckBox" Content="冲突时仍删除来源参数（会丢弃来源值）"
                          Margin="0,0,0,6"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Padding="8,6" Margin="0,0,0,6">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" Content="全选可处理项" Width="104" Margin="0,0,7,0"
                                Click="SelectAllButton_Click" IsEnabled="False"/>
                        <Button x:Name="SelectNoneButton" Content="全不选" Width="82" Margin="0,0,7,0"
                                Click="SelectNoneButton_Click" IsEnabled="False"/>
                        <Button x:Name="InvertSelectionButton" Content="反选" Width="82" Margin="0,0,7,0"
                                Click="InvertSelectionButton_Click" IsEnabled="False"/>
                        <Button x:Name="SelectFirstTenButton" Content="测试：最多 10 个来源参数" Width="162"
                                Click="SelectFirstTenButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectionSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{DynamicResource SecondaryLabel}" Text="未选择参数组"/>
                </Grid>
            </Border>

            <DataGrid x:Name="ResultGrid" Grid.Row="1"
                      ItemsSource="{Binding}" IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True" CanUserReorderColumns="True"
                      RowHeight="25" ColumnHeaderHeight="30">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="处理" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="GroupSelectionCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="参数名称" Width="210" Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="绑定" Width="62" Binding="{Binding BindingText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="保留 ID" Width="82" Binding="{Binding KeeperIdText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="来源 ID" Width="220" Binding="{Binding SourceIdsText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="总数" Width="54" Binding="{Binding Records.Count}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="共享参数" Width="105" Binding="{Binding SharedSummary}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="引用关系" Width="170" Binding="{Binding ReferenceSummary}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="状态" Width="*" MinWidth="260" Binding="{Binding Status}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4" Margin="14,0,14,10" Style="{DynamicResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource GridHeaderBg}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1">
                    <TextBlock Text="运行输出与预览报告" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0" Padding="8"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{DynamicResource BottomBar}">
            <Grid>
                <TextBlock x:Name="SummaryText" Text="尚未扫描。" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="功能说明" Width="92" Margin="0,0,10,0" Click="HelpButton_Click"/>
                    <Button x:Name="CloseButton" Content="关闭" Width="82" Style="{DynamicResource PrimaryButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
