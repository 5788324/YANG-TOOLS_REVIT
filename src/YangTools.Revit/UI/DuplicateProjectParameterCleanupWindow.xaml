<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.DuplicateProjectParameterCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重复项目参数清理"
        Width="1220" Height="800" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="重复项目参数清理" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="先扫描，再选择要合并的参数"
                               Foreground="{DynamicResource TitleText}" FontSize="11" Margin="12,3,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,12,14,0" Style="{DynamicResource CardBorder}" Padding="12">
            <StackPanel>
                <TextBlock Text="扫描同名参数，选中后可合并绑定和值。删除前会显示影响范围。" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,10,14,8">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="ScanButton" Content="扫描重复参数" Width="132" Margin="0,0,8,6" Click="ScanButton_Click"/>
                    <Button x:Name="MergeButton" Content="合并所选参数" Width="145" Margin="0,0,8,6"
                            Style="{DynamicResource PrimaryButton}" Click="MergeButton_Click" IsEnabled="False"/>
                </WrapPanel>
                <Expander x:Name="DetailsExpander" Header="更多操作与详情" Expanded="ParameterDetails_Changed" Collapsed="ParameterDetails_Changed">
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="QuickButton" Content="合并并清理" Width="130" Margin="0,0,8,6"
                                Click="QuickButton_Click" IsEnabled="False"/>
                        <Button x:Name="DeleteButton" Content="仅删除可删除项" Width="145" Margin="0,0,8,6"
                                Click="DeleteButton_Click" IsEnabled="False"/>
                        <Button x:Name="ReportButton" Content="打开 CSV 报告" Width="116" Margin="0,0,8,6"
                                Click="ReportButton_Click" IsEnabled="False"/>
                        <Button x:Name="SelectFirstTenButton" Content="试选前 10 个来源参数" Width="162" Margin="0,0,8,6"
                                Click="SelectFirstTenButton_Click" IsEnabled="False"/>
                        <CheckBox x:Name="AllowDeleteSharedCheckBox" Content="允许删除共享参数（高风险）"
                                  Margin="0,0,0,6" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Padding="8,6" Margin="0,0,0,6">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SelectAllButton" Content="全选可处理项" Width="104" Margin="0,0,7,0"
                                Click="SelectAllButton_Click" IsEnabled="False"/>
                        <Button x:Name="SelectNoneButton" Content="全不选" Width="82" Margin="0,0,7,0"
                                Click="SelectNoneButton_Click" IsEnabled="False"/>
                        <Button x:Name="InvertSelectionButton" Content="反选" Width="82" Margin="0,0,7,0"
                                Click="InvertSelectionButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectionSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{DynamicResource SecondaryLabel}" Text="未选择参数组"/>
                </Grid>
            </Border>

            <DataGrid x:Name="ResultGrid" Grid.Row="1"
                      ItemsSource="{Binding}" IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True" CanUserReorderColumns="True"
                      RowHeight="25" ColumnHeaderHeight="30">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource SharedDataGridColumnHeaderStyle}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="处理" Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="GroupSelectionCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="参数名称" Width="210" Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="绑定" Width="62" Binding="{Binding BindingText}" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="KeeperIdColumn" Visibility="Collapsed" Header="保留 ID" Width="82" Binding="{Binding KeeperIdText}" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="SourceIdColumn" Visibility="Collapsed" Header="来源 ID" Width="220" Binding="{Binding SourceIdsText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="总数" Width="54" Binding="{Binding Records.Count}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="共享参数" Width="105" Binding="{Binding SharedSummary}" IsReadOnly="True"/>
                    <DataGridTextColumn x:Name="ReferencesColumn" Visibility="Collapsed" Header="引用关系" Width="170" Binding="{Binding ReferenceSummary}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="状态" Width="*" MinWidth="260" Binding="{Binding Status}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border x:Name="ParameterLogPanel" Grid.Row="4" Margin="14,0,14,10" Height="165"
                Style="{DynamicResource CardBorder}" Visibility="Collapsed" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource GridHeaderBg}" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1">
                    <TextBlock Text="运行输出与预览报告" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" BorderThickness="0" Padding="8"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{DynamicResource BottomBar}">
            <Grid>
                <TextBlock x:Name="SummaryText" Text="尚未扫描。" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="功能说明" Width="92" Margin="0,0,10,0" Click="HelpButton_Click"/>
                    <Button x:Name="CloseButton" Content="关闭" Width="82" Style="{DynamicResource PrimaryButton}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
