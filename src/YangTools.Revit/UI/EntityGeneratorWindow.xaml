<Window x:Class="YangTools.Revit.UI.EntityGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实体生成（Loft）"
        Width="550" SizeToContent="Height"
        MinWidth="530" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        AllowsTransparency="True"
        WindowStyle="None"
        BorderThickness="1"
        BorderBrush="{DynamicResource WindowBorder}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="实体生成(Loft)" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TitleText}"/>
                    <TextBlock Text=" | 基于轮廓生成放样三维实体" FontSize="13" Foreground="{DynamicResource TitleText}" Margin="8,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="32"
                        Content="X" FontSize="15" FontWeight="Bold"
                        Foreground="{DynamicResource TitleText}" Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="closebd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="closebd" Property="Background" Value="{DynamicResource DangerBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="22,18">
                <Border Background="{DynamicResource PanelBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource WindowBorder}" Padding="18">
                    <StackPanel>

                        <TextBlock Text="轮廓选择" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtProfiles" Text="未选择轮廓" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource SecondaryText}"/>
                            <Button Grid.Column="1" Content="选择轮廓" Style="{DynamicResource StandardButton}" Padding="15,4" Click="BtnSelectProfiles_Click"/>
                        </Grid>

                        <TextBlock Text="新建族名称" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFamilyName" Text="GeneratedLoftFamily" FontSize="14" Padding="6" Background="{DynamicResource GridHover}" BorderBrush="{DynamicResource BtnBorder}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="族类别" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbCategory" FontSize="14" Padding="6" Background="{DynamicResource GridHover}" BorderBrush="{DynamicResource BtnBorder}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox x:Name="ChkIsVoid" Content="生成空心模型 (Void)" FontSize="14" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkCutWithVoids" Content="载入时剪切空心" FontSize="14" Foreground="{DynamicResource PrimaryText}" IsEnabled="{Binding ElementName=ChkIsVoid, Path=IsChecked}" Margin="0,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="材质（可选，留空=按类别/默认材质）" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbMaterial" IsEditable="True" IsTextSearchEnabled="True"
                                  FontSize="14" Padding="6" Background="{DynamicResource GridHover}"
                                  BorderBrush="{DynamicResource BtnBorder}" Margin="0,0,0,4"/>
                        <TextBlock Text="留空时不创建材质参数，实体使用族类别/模板默认材质。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12"/>

                        <TextBlock Text="目标标高（关联标高，保持原几何高度）" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbLevel" FontSize="14" Padding="6" Background="{DynamicResource GridHover}" BorderBrush="{DynamicResource BtnBorder}" Margin="0,0,0,4"/>
                        <TextBlock Text="实体上下界来自原轮廓世界坐标；这里只修改关联标高，不调整 Base/Top Offset。"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12"/>

                        <TextBlock Text="族模板路径" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTemplatePath" FontSize="14" Padding="6" Background="{DynamicResource GridHover}" BorderBrush="{DynamicResource BtnBorder}"/>
                            <Button Grid.Column="1" Content="浏览..." Style="{DynamicResource StandardButton}" Margin="10,0,0,0" Padding="15,4" Click="BtnBrowseTemplate_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BottomBarBg}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource WindowBorder}">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="准备就绪" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SuccessColor}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" Style="{DynamicResource StandardButton}" IsCancel="True" Click="CloseButton_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnGenerate" Content="生成" Style="{DynamicResource PrimaryButton}" IsDefault="True" Click="BtnGenerate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
