<Window x:Class="YangTools.Revit.UI.TextParagraphWidthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字段落宽度" Width="570" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}">
    <StackPanel Margin="18">
        <DataGrid x:Name="NotesGrid" MaxHeight="270" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文字" Binding="{Binding Text}" Width="*"/>
                <DataGridTextColumn Header="图元 ID" Binding="{Binding Id}" Width="90"/>
                <DataGridTextColumn Header="纸面宽度 (mm)" Binding="{Binding WidthMm, StringFormat=0.###}" Width="130"/>
                <DataGridTextColumn Header="换行" Binding="{Binding Wrapping}" Width="75"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EditPanel" Orientation="Horizontal" Margin="0,12,0,0">
            <Label Content="统一纸面宽度 (mm)" Target="{Binding ElementName=WidthBox}"
                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            <TextBox x:Name="WidthBox" Width="112" Padding="5" Margin="8,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Content="应用" Width="76" Padding="5" IsDefault="True" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="关闭" Width="76" Padding="5" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
