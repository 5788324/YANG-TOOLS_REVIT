<Window x:Class="YangTools.Revit.UI.ParameterSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择参数" Width="380" Height="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="NoResize" Background="Transparent">
    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="7,7,0,0" Background="{DynamicResource TitleBarGradient}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{DynamicResource TitleText}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0"/>
            </Border>

            <ListBox x:Name="OptionsList" Grid.Row="1" Margin="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     SelectionChanged="OptionsList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Content="取消" MinWidth="72" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="确定" MinWidth="72" IsDefault="True"
                        IsEnabled="False" Click="Confirm_Click" Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
