<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.SheetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图纸与图框管理" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBg}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="隐藏/删除此列 (Hide Column)">
                            <MenuItem.Style>
                                <Style TargetType="{x:Type MenuItem}">
                                    <EventSetter Event="Click" Handler="HideColumn_Click" />
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,0,0,2">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Background="{DynamicResource TitleBarGradient}">
                <Grid>
                    <TextBlock Text="图纸与图框管理" Foreground="{DynamicResource TitleText}" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="14"/>
                    <Button Style="{DynamicResource CloseButton}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="10,0,10,10" SelectionChanged="TabControl_SelectionChanged">
                <!-- 图纸管理 Tab -->
                <TabItem Header="图纸">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="搜索图号或图名" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryText}"/>
                                <TextBox x:Name="SheetSearchBox" Width="150" VerticalContentAlignment="Center" TextChanged="SheetSearchBox_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="添加参数列" Click="AddParameterColumn_Click" ToolTip="添加图纸自定义参数">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="添加参数列" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="导出 Excel" Click="ExportSheetExcel_Click" ToolTip="导出全部图纸数据">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="导出 Excel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="导入 Excel" Click="ImportSheetExcel_Click" ToolTip="按图号更新。项目中不存在的图号需确认后才新建。">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="导入 Excel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="删除图纸" Click="DeleteSheets_Click" Foreground="{DynamicResource DangerBg}" ToolTip="删除选中的图纸">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="删除图纸" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="刷新" Click="Refresh_Click" ToolTip="重新加载图纸">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                        
                        <DataGrid x:Name="SheetsDataGrid" Grid.Row="1" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource GridLine}" VerticalGridLinesBrush="{DynamicResource GridLine}" RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" IsReadOnly="True" />
                                <DataGridTextColumn Header="图号" Binding="{Binding SheetNumber, UpdateSourceTrigger=LostFocus}" Width="150"/>
                                <DataGridTextColumn Header="图名" Binding="{Binding SheetName, UpdateSourceTrigger=LostFocus}" Width="250"/>
                                <DataGridTemplateColumn Header="修订" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Revisions}" VerticalAlignment="Center" Margin="5,0" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="..." Width="30" Height="22" Margin="2" Padding="0" Click="EditRevisions_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="SheetStatusBarText" Grid.Row="2" Text="共计 0 张图纸" Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>

                <!-- 图框管理 Tab -->
                <TabItem Header="图框">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                            <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="导出 Excel" Click="ExportTitleblockExcel_Click" ToolTip="导出图框参数">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="导出 Excel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="批量导入参数" Click="ImportTitleblockExcel_Click" ToolTip="导入修改后的图框参数">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="批量导入参数" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="在视图中选择" Click="SelectTitleblockInView_Click" ToolTip="在 Revit 视图中定位选中的图框">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="在视图中选择" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource IconButton}" AutomationProperties.Name="刷新" Click="RefreshTitleblock_Click" ToolTip="重新加载图框数据">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="刷新" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <DataGrid x:Name="TitleblocksDataGrid" Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="所属图纸" Binding="{Binding SheetNumber}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="图名" Binding="{Binding SheetName}" Width="150" IsReadOnly="True" />
                                <DataGridTextColumn Header="图元ID" Binding="{Binding InstanceIdValue}" Width="80" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="图框类型 (换型)" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{DynamicResource CompactComboBox}" ItemsSource="{Binding DataContext.AvailableTitleblocks, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                                      SelectedValue="{Binding TypeId, Mode=OneWay}"
                                                      SelectionChanged="TitleblockComboBox_SelectionChanged"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TitleblockStatusBarText" Grid.Row="2" Text="共计 0 个图框实例" Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
