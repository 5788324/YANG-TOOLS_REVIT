<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.FamilyMaterialBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量绑定材质" Width="900" Height="690" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="批量绑定族材质参数" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"
                       Text="选择一个或多个可编辑载入族，在族文档中创建/复用统一的材质族参数，并把所有具有 Material 参数的可绑定几何关联到它，然后自动重新载入当前项目。"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Height="30" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged" ToolTip="按族名或当前类别筛选"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="全选" Width="62" Margin="0,0,6,0" Click="SelectAll_Click"/>
                <Button Content="反选" Width="62" Margin="0,0,6,0" Click="Invert_Click"/>
                <Button Content="全不选" Width="72" Click="SelectNone_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="FamilyGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow"
                  IsReadOnly="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Width="58" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="族名称" Width="2*" Binding="{Binding FamilyName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="当前类别" Width="1.4*" Binding="{Binding CurrentCategory}" IsReadOnly="True"/>
                <DataGridTextColumn Header="类型数" Width="72" Binding="{Binding TypeCount}" IsReadOnly="True"/>
                <DataGridTextColumn Header="实例数" Width="72" Binding="{Binding InstanceCount}" IsReadOnly="True"/>
                <DataGridTextColumn Header="状态" Width="110" Binding="{Binding StatusText}" IsReadOnly="True"/>
                <DataGridTextColumn Header="ElementId" Width="88" Binding="{Binding ElementIdValue}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="参数名称：" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <TextBox x:Name="ParameterNameBox" Grid.Column="1" Height="34" MinWidth="280"
                     Padding="8,2" VerticalContentAlignment="Center" Text="材质"
                     ToolTip="输入要在族中创建或复用的材质族参数名称"/>
            <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="参数方式：" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TypeParameterRadio" Content="类型参数" IsChecked="True" Margin="0,0,22,0"/>
                <RadioButton x:Name="InstanceParameterRadio" Content="实例参数"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="RebindExistingCheckBox" IsChecked="True" VerticalAlignment="Center"
                      Content="覆盖已有的其它材质参数绑定（将几何统一重新关联到本次参数）"/>
            <TextBlock x:Name="SelectionStatus" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Text="已选择 0 个族"/>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningColor}"
                       Text="说明：本工具只关联族几何的 Material 属性，不会自动给参数指定某个项目材质。若同名参数已存在但不是材质类型，或类型/实例方式不一致，该族会安全失败而不会替换旧参数。不可绑定几何、空心体、引用元素等会自动跳过。"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0">
                <Button Content="取消" Width="82" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="执行绑定" Width="96" Height="32" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
