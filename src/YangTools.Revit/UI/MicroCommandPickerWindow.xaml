<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.MicroCommandPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择微工具入口" Height="420" Width="620" MinHeight="340" MinWidth="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,8,0">
                <TextBlock Text="选择微工具入口" Style="{DynamicResource WindowTitle}"/>
                <Button HorizontalAlignment="Right" Style="{DynamicResource CloseButton}" Click="CancelButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="该 DLL 包含多个 IExternalCommand，请选择本次要运行的入口。"
                       Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,10"/>
            <ListBox x:Name="CommandsListBox" Grid.Row="1" Style="{DynamicResource StandardListBox}"
                     MouseDoubleClick="CommandsListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FullName}" Style="{DynamicResource SecondaryLabel}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="90" Margin="0,0,10,0" Style="{DynamicResource StandardButton}"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button Content="运行" Width="90" Style="{DynamicResource PrimaryButton}"
                        Click="RunButton_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
