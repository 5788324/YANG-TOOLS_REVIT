<Window x:Class="YangTools.Revit.UI.AlignTextToTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文本基准对齐"
        Width="500" MinWidth="460" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="文本基准对齐" Style="{DynamicResource WindowTitle}"/>
                    <TextBlock Text="以一个源文本的插入点和旋转角度为基准" Foreground="{DynamicResource TitleText}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="?" Width="30" Height="28" Margin="0,0,6,0"
                        Style="{DynamicResource StandardButton}" ToolTip="功能说明" Click="HelpButton_Click"/>
                <Button Grid.Column="2" Style="{DynamicResource CloseButton}" Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18,16,18,12">
            <Border Style="{DynamicResource CardBorder}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,12,10">
                        <TextBlock Text="源文本（保持不动）" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock x:Name="TxtSourceStatus" Text="未选择源文本" Foreground="{DynamicResource DangerBg}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Row="0" Grid.Column="1" Content="选择源文本" MinWidth="102" Height="32"
                            Style="{DynamicResource StandardButton}" Click="BtnSelectSource_Click"/>

                    <StackPanel Grid.Row="1" Margin="0,0,12,0">
                        <TextBlock Text="目标文本（将被移动/旋转）" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock x:Name="TxtTargetStatus" Text="未选择目标文本" Foreground="{DynamicResource DangerBg}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="1" Content="选择目标文本" MinWidth="102" Height="32"
                            Style="{DynamicResource StandardButton}" Click="BtnSelectTargets_Click"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="对齐内容" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAlignX" Content="X 坐标相同（目标插入点沿竖直线排列）" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAlignY" Content="Y 坐标相同（目标插入点沿水平线排列）" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAlignRotation" Content="旋转角度相同（围绕目标自身插入点旋转）" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkMatchParagraphWidth" Content="段落宽度相同（复制源文字框宽度）"
                              ToolTip="将目标 TextNote.Width 设置为源文本的 Width；文本内容和文字类型保持不变。"/>
                </StackPanel>
            </Border>

            <TextBlock Margin="2,10,2,0" Style="{DynamicResource SecondaryLabel}" TextWrapping="Wrap"
                       Text="说明：X/Y 对齐的是 TextNote.Coord 插入点；“段落宽度相同”复制源文本的 TextNote.Width，并可能改变目标文本换行。锁定、成组、受约束或宽度范围不兼容的目标会被跳过。"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource BottomBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="功能说明" Width="92" Margin="0,0,10,0" Style="{DynamicResource StandardButton}" Click="HelpButton_Click"/>
                <Button Content="取消" Width="82" Margin="0,0,10,0" Style="{DynamicResource StandardButton}" Click="BtnCancel_Click"/>
                <Button Content="确定" Width="90" Style="{DynamicResource PrimaryButton}" Click="BtnOk_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
