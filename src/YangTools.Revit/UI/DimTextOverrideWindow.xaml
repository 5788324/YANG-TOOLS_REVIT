<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="YangTools.Revit.UI.DimTextOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注文本替换" Height="300" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Microsoft YaHei UI" WindowStyle="None" AllowsTransparency="True"
        BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarGradient}" CornerRadius="8,8,0,0" MouseDown="Window_MouseDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="标注文本替换" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TitleText}"/>
                    <TextBlock Text="自定义标注显示文本" FontSize="12" Foreground="{DynamicResource TitleText}" Margin="8,2,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="X" FontSize="14" Foreground="{DynamicResource TitleText}" Click="CloseButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="30" Height="30"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,15">
            <TextBlock x:Name="TxtSelectedCount" Text="已选中 0 个标注" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12"/>
            <TextBlock Text="替换文本：" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtOverride" FontSize="14" Padding="6" Margin="0,0,0,12"/>
            <CheckBox x:Name="ChkClear" Content="清除覆盖文本（恢复为原始数值显示）" Margin="0,5,0,0"/>
            <TextBlock Text="提示：输入自定义文本（字符串/数字/字母），替换标注显示数值。" FontSize="11" Foreground="{DynamicResource SecondaryText}" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource BottomBarBg}" CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                <Button Content="取 消" Style="{StaticResource FlatButton}" Click="CloseButton_Click" Margin="0,0,10,0"/>
                <Button Content="确认替换" Style="{StaticResource AccentButton}" Click="BtnConfirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
