<controls:YangWindow x:Class="YangTools.Revit.UI.ExportTextForAiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YangTools.Revit.UI.Controls"
        Title="导出文字（AI 审校）" Subtitle="一键提取图纸文字与拼写校审提示词"
        Width="660" Height="580" MinWidth="520" MinHeight="460"
        ShowMaximizeButton="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="导出范围" Style="{DynamicResource SecondaryLabel}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbCurrentView" Content="当前图纸 / 视图（含图纸内图例与视口）" IsChecked="True" Margin="0,0,18,0" Checked="Option_Changed"/>
                    <RadioButton x:Name="RbSelection" Content="当前选中" Margin="0,0,18,0" Checked="Option_Changed"/>
                    <RadioButton x:Name="RbProject" Content="全项目" Checked="Option_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkTextNotes" Content="视图与图例文字（TextNote）" IsChecked="True" Margin="0,2,18,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="ChkViewTitles" Content="视图 / 图纸名称" IsChecked="True" Margin="0,2,18,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="ChkDeduplicate" Content="去重并统计次数" IsChecked="True" Margin="0,2,18,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="ChkIncludePrompt" Content="附带 AI 拼写与缩写审校提示词" IsChecked="True" Margin="0,2,0,2" Checked="Option_Changed" Unchecked="Option_Changed"/>
            </WrapPanel>
        </Border>

        <TextBox Grid.Row="2" x:Name="PreviewBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="12"
                 AcceptsReturn="True"/>

        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{DynamicResource SecondaryLabel}" Margin="0,10,0,12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyAiButton" Content="复制给 AI" Style="{DynamicResource PrimaryButton}" Padding="16,6" IsDefault="True" Click="CopyAi_Click" Margin="0,0,8,0"/>
            <Button Content="导出 Markdown" Style="{DynamicResource StandardButton}" Padding="14,6" Click="ExportMd_Click" Margin="0,0,8,0"/>
            <Button Content="导出 CSV" Style="{DynamicResource StandardButton}" Padding="14,6" Click="ExportCsv_Click" Margin="0,0,8,0"/>
            <Button Content="关闭" Style="{DynamicResource StandardButton}" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:YangWindow>
