<Window x:Class="YangTools.Revit.UI.FamilyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="族文档管理" Height="780" Width="1280" MinHeight="650" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WindowBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="RowBackground" Value="{DynamicResource GridRowBg}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBg}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLine}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="RowHeight" Value="30"/>
                <Setter Property="ColumnHeaderHeight" Value="36"/>
                <Setter Property="MinColumnWidth" Value="90"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BtnBg}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WindowBorder}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CategoryGroupStyle" TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <StackPanel>
                                <Border Background="{DynamicResource BtnBorder}" Padding="10,5">
                                    <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Text="{Binding Name}" />
                                </Border>
                                <ItemsPresenter />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="7,7,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="{DynamicResource TitleBarGradient}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <TextBlock Text="族文档管理" Foreground="{DynamicResource TitleText}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text=" Family Manager V2.1" Foreground="{DynamicResource TitleText}" Opacity="0.78" FontSize="13" Margin="6,2,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="15">
                                    <Path Data="M 10,10 L 20,20 M 20,10 L 10,20" Stroke="{DynamicResource TitleText}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBg}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧族列表：固定 340px，避免统计文字和族名互相挤压。 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="类别过滤" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" x:Name="CategoryFilterComboBox" MinWidth="200" SelectionChanged="FilterChanged"/>
                            <TextBlock Grid.Row="2" Text="搜索族" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" x:Name="SearchBox" Padding="6,4" TextChanged="FilterChanged"/>
                            <CheckBox Grid.Row="4" x:Name="UnusedFamilyOnlyCheckBox" Content="仅显示有未使用类型的族" VerticalAlignment="Center" Checked="UnusedFamilyOnlyCheckBox_Changed" Unchecked="UnusedFamilyOnlyCheckBox_Changed"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="FamilyListBox" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" SelectionChanged="FamilyListBox_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource CategoryGroupStyle}" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="40">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="18"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding FamilyName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeCount, StringFormat=类型 {0}}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                        <TextBlock Text="{Binding InstanceCount, StringFormat=实例 {0}}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                        <TextBlock Text="{Binding UnusedTypeCount, StringFormat=未用 {0}}" Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,1,0,0" Padding="10,0">
                        <TextBlock x:Name="FamilyListStatusText" Text="族：0" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{DynamicResource WindowBorder}"/>

                <!-- 右侧类型管理 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="24"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SelectedFamilyTitle" Text="请在左侧选择一个族" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" x:Name="RenameFamilyBtn" ToolTip="重命名族" Style="{DynamicResource IconButton}" Click="RenameFamily_Click" Visibility="Collapsed" Margin="6,0,0,0">
                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="SelectedFamilyStatsText" Text="实例 0 · 使用类型 0 · 未使用类型 0 · 当前视图 0" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <CheckBox Grid.Row="2" x:Name="UnusedTypesOnlyCheckBox" Content="类型表仅显示未使用类型" VerticalAlignment="Center" Checked="UnusedTypesOnlyCheckBox_Changed" Unchecked="UnusedTypesOnlyCheckBox_Changed"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ManageInstancesBtn" Content="管理实例" Width="92" Height="32" Margin="6,0" Style="{DynamicResource PrimaryButton}" Click="ManageInstances_Click" IsEnabled="False"/>
                                <Button Content="批量导出 RFA" Width="112" Height="32" Margin="6,0" Click="ExportSelectedRfa_Click" ToolTip="导出左侧选中的一个或多个族；未多选时导出当前族"/>
                                <Button Content="清理未使用类型" Width="120" Height="32" Margin="6,0" Style="{DynamicResource DangerButton}" Click="CleanupUnusedTypes_Click" ToolTip="仅删除 Usage=0 的类型；先 Trial Delete 并显示连带影响"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="TypeDataGrid" Grid.Row="1" Margin="10" CellEditEnding="TypeDataGrid_CellEditEnding" Visibility="Collapsed" FrozenColumnCount="3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="类型名称 (Type Name)" Binding="{Binding TypeName}" Width="220" MinWidth="170" MaxWidth="320"/>
                            <DataGridTextColumn Header="使用数" Binding="{Binding UsageCount}" Width="82" MinWidth="72" MaxWidth="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding UsageStatus}" Width="90" MinWidth="82" MaxWidth="110" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="请从左侧选择一个族" FontSize="18" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="V2.1 会显示类型使用情况，并支持未使用类型安全清理" FontSize="13" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- 单行工具栏 + 横向滚动，窗口变窄时不允许按钮挤成多行。 -->
                    <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="0,1,0,0" Padding="10,5">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button ToolTip="刷新族/类型使用统计" Style="{DynamicResource IconButton}" Click="RefreshFamilyManager_Click" Foreground="{DynamicResource InfoColor}"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="重置参数列" Style="{DynamicResource IconButton}" Click="ResetColumns_Click"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="复制类型" Style="{DynamicResource IconButton}" Click="Duplicate_Click"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="更改类别" Style="{DynamicResource IconButton}" Click="ChangeCategory_Click"><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="批量重命名" Style="{DynamicResource IconButton}" Click="BatchRename_Click"><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="导出当前族 RFA" Style="{DynamicResource IconButton}" Click="ExportRfa_Click" Foreground="{DynamicResource SuccessColor}"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="导出 Excel" Style="{DynamicResource IconButton}" Click="ExportExcel_Click"><TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="导入 Excel" Style="{DynamicResource IconButton}" Click="ImportExcel_Click" Foreground="{DynamicResource AccentColor}"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                                <Button ToolTip="删除选中类型/族" Style="{DynamicResource IconButton}" Click="Delete_Click" Foreground="{DynamicResource DangerBg}"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
